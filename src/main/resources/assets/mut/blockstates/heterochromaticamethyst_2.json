{
  "multipart": [
    { "when": { "facing": "down" },  "apply": { "model": "mut:block/heterochromaticamethyst_2", "x": 180 } },
    { "when": { "facing": "up" },    "apply": { "model": "mut:block/heterochromaticamethyst_2" } },
    { "when": { "facing": "north" }, "apply": { "model": "mut:block/heterochromaticamethyst_2", "x": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "mut:block/heterochromaticamethyst_2", "x": 90, "y": 180 } },
    { "when": { "facing": "west" },  "apply": { "model": "mut:block/heterochromaticamethyst_2", "x": 90, "y": 270 } },
    { "when": { "facing": "east" },  "apply": { "model": "mut:block/heterochromaticamethyst_2", "x": 90, "y": 90 } }
  ]
}